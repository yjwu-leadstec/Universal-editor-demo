{
  "models": [
    {
      "id": "page-metadata",
      "fields": [
        {
          "component": "text",
          "valueType": "string",
          "name": "jcr:title",
          "label": "Title"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "jcr:description",
          "label": "Description"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "keywords",
          "multi": true,
          "label": "Keywords"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "ogTitle",
          "label": "Open Graph Title",
          "description": "Optional social-title override; falls back to the page title"
        },
        {
          "component": "textarea",
          "valueType": "string",
          "name": "ogDescription",
          "label": "Open Graph Description",
          "description": "Optional social-description override; falls back to the page description"
        },
        {
          "component": "reference",
          "valueType": "string",
          "name": "ogImage",
          "label": "Open Graph Image",
          "multi": false
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "ogImageAlt",
          "label": "Open Graph Image Alt Text"
        },
        {
          "component": "aem-content",
          "valueType": "string",
          "name": "nav",
          "label": "Navigation Override",
          "description": "Optional same-site nav page; the current language root is used by default",
          "validation": {
            "rootPath": "/content/demo-site"
          }
        },
        {
          "component": "aem-content",
          "valueType": "string",
          "name": "footer",
          "label": "Footer Override",
          "description": "Optional same-site footer page; the current language root is used by default",
          "validation": {
            "rootPath": "/content/demo-site"
          }
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "language",
          "label": "Language Override",
          "description": "Optional BCP 47 language tag; normally inferred from the URL"
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "direction",
          "label": "Text Direction Override",
          "description": "Optional; normally inferred from the language",
          "options": [
            { "name": "Automatic", "value": "" },
            { "name": "Left to right", "value": "ltr" },
            { "name": "Right to left", "value": "rtl" }
          ]
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "mediaType",
          "label": "Media Entry Type",
          "options": [
            { "name": "Not a media entry", "value": "" },
            { "name": "Newsroom", "value": "newsroom" },
            { "name": "Photos", "value": "photos" },
            { "name": "Videos", "value": "videos" }
          ]
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "visible",
          "label": "Show in Media Center",
          "options": [
            { "name": "Visible", "value": "true" },
            { "name": "Hidden", "value": "false" }
          ]
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "displayMode",
          "label": "Media Feed Layout",
          "options": [
            { "name": "Grid card", "value": "grid" },
            { "name": "Full width", "value": "full-width" }
          ]
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "featured",
          "label": "Featured in Media Feed",
          "options": [
            { "name": "No", "value": "false" },
            { "name": "Yes", "value": "true" }
          ]
        },
        {
          "component": "number",
          "valueType": "number",
          "name": "sortOrder",
          "label": "Media Sort Order"
        },
        {
          "component": "date",
          "valueType": "string",
          "name": "publishDate",
          "label": "Media Publication Date"
        },
        {
          "component": "reference",
          "valueType": "string",
          "name": "coverImage",
          "label": "Media Cover Image",
          "multi": false
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "imageAlt",
          "label": "Media Cover Image Alt Text"
        },
        {
          "component": "number",
          "valueType": "number",
          "name": "photoCount",
          "label": "Photo Count"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "videoDuration",
          "label": "Video Duration"
        }
      ]
    }
  ]
}
