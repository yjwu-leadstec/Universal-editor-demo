{
  "definitions": [
    {
      "title": "Home Carousel",
      "id": "home-carousel",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Home Carousel",
              "model": "home-carousel",
              "filter": "home-carousel"
            }
          }
        }
      }
    },
    {
      "title": "Carousel Card",
      "id": "carousel-card",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block/item",
            "template": {
              "name": "Carousel Card",
              "model": "carousel-card"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "home-carousel",
      "fields": [
        {
          "component": "text",
          "name": "eyebrow",
          "label": "Eyebrow",
          "description": "Small line above the heading, shown on the Tech variant (e.g. Li Technology)",
          "valueType": "string"
        },
        {
          "component": "text",
          "name": "heading",
          "label": "Heading",
          "description": "Section heading shown on desktop",
          "valueType": "string"
        },
        {
          "component": "text",
          "name": "mobileHeading",
          "label": "Mobile Heading",
          "description": "Optional heading for small screens; use \\n to force a line break",
          "valueType": "string"
        },
        {
          "component": "select",
          "name": "classes",
          "label": "Variant",
          "description": "Story: brand stories with video cards. Tech: image cards with an eyebrow",
          "value": "story",
          "valueType": "string",
          "options": [
            { "name": "Story", "value": "story" },
            { "name": "Tech", "value": "tech" }
          ]
        },
        {
          "component": "boolean",
          "name": "loopVideo",
          "label": "Loop Videos",
          "description": "Replay card videos continuously. When off, a video plays once and shows a Replay button",
          "valueType": "boolean",
          "value": false
        },
        {
          "component": "text",
          "name": "id",
          "label": "ID",
          "description": "Optional page anchor",
          "valueType": "string"
        }
      ]
    },
    {
      "id": "carousel-card",
      "fields": [
        {
          "component": "reference",
          "name": "image",
          "label": "Poster / Background Image",
          "description": "Card background image, and the poster fallback for video cards",
          "valueType": "string",
          "multi": false
        },
        {
          "component": "text",
          "name": "imageAlt",
          "label": "Image Alt Text",
          "valueType": "string"
        },
        {
          "component": "reference",
          "name": "video",
          "label": "Video (optional)",
          "description": "MP4 from AEM Assets for a Story card; plays automatically while the card is centred",
          "valueType": "string"
        },
        {
          "component": "text",
          "name": "title",
          "label": "Card Title",
          "description": "Card copy; use \\n to force a line break",
          "valueType": "string"
        },
        {
          "component": "text",
          "name": "actionLabel",
          "label": "Action Text (optional)",
          "description": "Shown on Story cards, e.g. View Full Video",
          "valueType": "string"
        },
        {
          "component": "aem-content",
          "name": "link",
          "label": "Link (optional)",
          "valueType": "string"
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "home-carousel",
      "components": [
        "carousel-card"
      ]
    }
  ]
}
