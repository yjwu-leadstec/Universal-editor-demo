{
  "definitions": [
    {
      "title": "Home Banner",
      "id": "home-banner",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Home Banner",
              "model": "home-banner",
              "filter": "home-banner",
              "showOnSmallScreens": true
            }
          }
        }
      }
    },
    {
      "title": "Banner Slide",
      "id": "banner-slide",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block/item",
            "template": {
              "name": "Banner Slide",
              "model": "banner-slide"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "home-banner",
      "fields": [
        {
          "component": "boolean",
          "name": "showOnSmallScreens",
          "label": "Show on Small Screens",
          "description": "When off, the whole banner is hidden below 720px; medium and large screens still show it",
          "valueType": "boolean",
          "value": true
        },
        {
          "component": "reference",
          "name": "mobileImage",
          "label": "Mobile Feature Image",
          "description": "Dedicated hero image for small screens (720×1080 recommended, 2:3 ratio)",
          "valueType": "string",
          "multi": false
        },
        {
          "component": "text",
          "name": "mobileImageAlt",
          "label": "Mobile Image Alt Text",
          "valueType": "string"
        },
        {
          "component": "reference",
          "name": "mobileLogo",
          "label": "Mobile Feature Logo",
          "description": "Vehicle wordmark for the small-screen hero; falls back to the mobile title and subtitle",
          "valueType": "string",
          "multi": false
        },
        {
          "component": "text",
          "name": "mobileDamFolder",
          "label": "Mobile DAM Folder",
          "description": "DAM folder holding the mobile hero and logo; the original in the same folder is used when the optimised URL is unavailable",
          "valueType": "string"
        }
      ]
    },
    {
      "id": "banner-slide",
      "fields": [
        {
          "component": "reference",
          "name": "image",
          "label": "Background Image",
          "description": "Banner image (approx. 1920×817)",
          "valueType": "string",
          "multi": false
        },
        {
          "component": "text",
          "name": "imageAlt",
          "label": "Image Alt Text",
          "valueType": "string"
        },
        {
          "component": "reference",
          "name": "logo",
          "label": "Vehicle Logo",
          "description": "Vehicle wordmark; falls back to the title and subtitle",
          "valueType": "string",
          "multi": false
        },
        {
          "component": "text",
          "name": "title",
          "label": "Title",
          "description": "For example, Li i6",
          "valueType": "string"
        },
        {
          "component": "text",
          "name": "subtitle",
          "label": "Subtitle",
          "description": "For example, New-Form 5-Seat SUV",
          "valueType": "string"
        },
        {
          "component": "aem-content",
          "name": "link",
          "label": "Link",
          "description": "Link to the vehicle detail page",
          "valueType": "string"
        },
        {
          "component": "text",
          "name": "linkText",
          "label": "CTA Text",
          "value": "Learn More",
          "valueType": "string"
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "home-banner",
      "components": [
        "banner-slide"
      ]
    }
  ]
}
