{
  "definitions": [
    {
      "title": "Home Vehicle Grid",
      "id": "home-vehicle-grid",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Home Vehicle Grid",
              "model": "home-vehicle-grid",
              "filter": "home-vehicle-grid"
            }
          }
        }
      }
    },
    {
      "title": "Vehicle Tile",
      "id": "vehicle-tile",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block/item",
            "template": {
              "name": "Vehicle Tile",
              "model": "vehicle-tile"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "home-vehicle-grid",
      "fields": [
        {
          "component": "multiselect",
          "name": "classes",
          "label": "Options",
          "description": "Responsive visibility options",
          "valueType": "string",
          "options": [
            {
              "name": "Responsive",
              "children": [
                { "name": "Hide large tile on mobile", "value": "hide-large-mobile" }
              ]
            },
            {
              "name": "Artwork",
              "children": [
                { "name": "Light card artwork", "value": "light-cards" }
              ]
            }
          ]
        },
        {
          "component": "text",
          "name": "id",
          "label": "ID",
          "description": "Optional page anchor",
          "valueType": "string"
        }
      ]
    },
    {
      "id": "vehicle-tile",
      "fields": [
        {
          "component": "reference",
          "name": "image",
          "label": "Background Image",
          "description": "Card background image (large 960×540, small 480×540)",
          "valueType": "string",
          "multi": false
        },
        {
          "component": "text",
          "name": "imageAlt",
          "label": "Image Alt Text",
          "valueType": "string"
        },
        {
          "component": "reference",
          "name": "mobileImage",
          "label": "Mobile Background Image",
          "description": "Optional background image for mobile; the desktop image is used when empty",
          "valueType": "string",
          "multi": false
        },
        {
          "component": "text",
          "name": "mobileImageAlt",
          "label": "Mobile Image Alt Text",
          "valueType": "string"
        },
        {
          "component": "reference",
          "name": "logo",
          "label": "Vehicle Logo",
          "description": "Vehicle wordmark as a transparent PNG; the vehicle name text is shown when empty",
          "valueType": "string",
          "multi": false
        },
        {
          "component": "text",
          "name": "vehicleName",
          "label": "Vehicle Name",
          "description": "For example, Li i6、Li L9",
          "valueType": "string"
        },
        {
          "component": "text",
          "name": "subtitle",
          "label": "Subtitle",
          "description": "For example, New-Form 5-Seat SUV",
          "valueType": "string"
        },
        {
          "component": "select",
          "name": "size",
          "label": "Card Size",
          "description": "Large spans two columns, used for the first feature tile",
          "value": "small",
          "valueType": "string",
          "options": [
            { "name": "Small (1 column)", "value": "small" },
            { "name": "Large (2 columns)", "value": "large" }
          ]
        },
        {
          "component": "select",
          "name": "kind",
          "label": "Tile Kind",
          "description": "Charging renders a charging promo tile: copy aligned to the bottom with a single CTA",
          "value": "vehicle",
          "valueType": "string",
          "options": [
            { "name": "Vehicle", "value": "vehicle" },
            { "name": "Charging Promo", "value": "charging" }
          ]
        },
        {
          "component": "aem-content",
          "name": "link",
          "label": "Link",
          "description": "Link to the vehicle detail page",
          "valueType": "string"
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "home-vehicle-grid",
      "components": [
        "vehicle-tile"
      ]
    }
  ]
}
